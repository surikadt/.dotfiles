#!/usr/bin/env bash

direction="${1:-next}"

mapfile -t sessions < <(
    tmux list-sessions -F '#{session_id}' |
    sort -t '$' -k2,2n
)

current=$(tmux display-message -p '#{session_id}')
count=${#sessions[@]}

(( count > 1 )) || exit 0

for i in "${!sessions[@]}"; do
    if [[ "${sessions[i]}" == "$current" ]]; then
        if [[ "$direction" == "next" ]]; then
            target=$(( (i + 1) % count ))
        else
            target=$(( (i - 1 + count) % count ))
        fi

        tmux switch-client -t "${sessions[target]}" \; switch-client -T prefix
        exit 0
    fi
done
